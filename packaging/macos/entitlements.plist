<!-- Used only when the app is signed with a Developer ID (tools/package/make_dmg.sh, docs/SIGNING.md). OnAir loads radio and codec
     libraries and plug-ins that carry other signatures, and reads the microphone/sound card and USB radios. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
    <key>com.apple.security.device.usb</key><true/>
</dict>
</plist>
