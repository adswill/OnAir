# Lets a normal user open the USB radios OnAir drives, as soon as they are plugged in (no sudo, no replugging after a reboot).
# MODE/GROUP is for a plugdev member and for a login that does not know uaccess; TAG+="uaccess" gives the user at the desk access
# on any systemd desktop, so a missing plugdev group does no harm.
# Every id below comes from the rules file of the radio's own project (hackrf, rtl-sdr-blog, airspyone_host, airspyhf, bladeRF,
# LimeSuite, uhd, plutosdr-fw, SDRplay), so a radio that works with its own driver works with OnAir.

# HackRF: One and Pro (same id), Jawbreaker, rad1o, and the NXP boot loader (the radio before a firmware update)
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6089", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="604b", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="cc15", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc9", ATTR{idProduct}=="000c", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Airspy R2 and Mini, Airspy HF+
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="60a1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="03eb", ATTR{idProduct}=="800c", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# bladeRF 1 (and its older id), bladeRF 2.0 micro, and the Cypress FX3 boot loader both use before their firmware is loaded
SUBSYSTEM=="usb", ATTR{idVendor}=="2cf0", ATTR{idProduct}=="5246", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6066", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2cf0", ATTR{idProduct}=="5250", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="00f3", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# LimeSDR USB, LimeSDR Mini (FTDI; LimeSuite lists no other id), and the Cypress FX3 ids a LimeSDR USB shows before its firmware is loaded
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6108", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="601f", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="8613", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="00f1", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# PlutoSDR (ADALM-Pluto), also in its firmware update mode and the newer 2fa2 ids; ModemManager must not probe it as a modem
SUBSYSTEM=="usb", ATTR{idVendor}=="0456", ATTR{idProduct}=="b673", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2fa2", ATTR{idProduct}=="5a02", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0456", ATTR{idProduct}=="b674", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2fa2", ATTR{idProduct}=="5a32", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# USRP B200, B210, B200mini, B205mini (Ettus 2500, and the National Instruments ids of the same boards)
SUBSYSTEM=="usb", ATTR{idVendor}=="2500", ATTR{idProduct}=="0020", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2500", ATTR{idProduct}=="0021", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2500", ATTR{idProduct}=="0022", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2500", ATTR{idProduct}=="0023", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3923", ATTR{idProduct}=="7813", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3923", ATTR{idProduct}=="7814", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# SDRplay RSP1, RSP1A, RSP1B, RSP2, RSPduo, RSPdx, RSPdxR2 (every product of the SDRplay vendor id)
SUBSYSTEM=="usb", ATTR{idVendor}=="1df7", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# RTL-SDR: the RTL2832U ids of the osmocom rtl-sdr rules file (the RTL-SDR Blog and Nooelec dongles are 0bda:2838)
# original RTL2832U vid/pid (hama nano, for example)
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
# RTL2832U OEM vid/pid, e.g. ezcap EzTV668 (E4000), Newsky TV28T (E4000/R820T) etc.
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", ENV{ID_SOFTWARE_RADIO}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
