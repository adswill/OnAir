#include <winver.h>
1 ICON "OnAir.ico"
// GLFW gives its windows the icon named GLFW_ICON (its win32 window class); without it the title bar and the taskbar showed the default
// Windows icon while Explorer showed the logo (#442)
GLFW_ICON ICON "OnAir.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,1,0,0
PRODUCTVERSION 4,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "OnAir DVB-T2 / DVB-T / ATSC / DAB receiver"
      VALUE "ProductName", "OnAir"
      VALUE "ProductVersion", "4.1.0"
      VALUE "LegalCopyright", "Code: GPL-3.0-or-later. OnAir name and logo (c) 2026 Kristijonas Adomaitis, all rights reserved; the logo is not covered by the GPL."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
