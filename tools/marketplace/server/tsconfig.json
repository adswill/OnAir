{
  // Type check and build for the Node tests (wrangler bundles src/index.ts by itself for deploys).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-test",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
