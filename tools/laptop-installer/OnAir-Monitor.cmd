        self._write('build.log', '\n'.join(lines) + ('\n' if lines else ''))
        self.compiling = []
        if 9 <= t < 55:
            k = int(t * 2)
            self.compiling = [(now - ((j * 3 + k) % 11), DEMO_FILES[(k + j * 5) % len(DEMO_FILES)]) for j in range(6)]
        # ctest log
        tl = []
        if t >= 55:
            tt = min(t, 88) - 55
