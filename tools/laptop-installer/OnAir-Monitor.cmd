               'phase_list': [p[0] for p in phases_t], 'phase': cur_phase, 'phases': phases}
        self._write('current.json', json.dumps(cur))
        # configure log
        if t >= 4:
            cl = ['-- The C compiler identification is GNU 13.3.0', '-- Found Vulkan', '-- Found Rust 1.82.0']
