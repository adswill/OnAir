    def collect(self, now):
        m = {'now': now}
        if self.demo:
            self.demo.tick(now)
        cur = read_json(os.path.join(self.dir, 'current.json'), None)
        m['job'] = cur if isinstance(cur, dict) else None
        hist = read_json(os.path.join(self.dir, 'history.json'), [])
        m['history'] = [h for h in hist if isinstance(h, dict)] if isinstance(hist, list) else []
        m['build'] = self.build.get(os.path.join(self.dir, 'build.log'))
        m['ctest'] = self.ctest.get(os.path.join(self.dir, 'ctest.log'))
        m['configure_last'] = ''
        for line in reversed(read_tail(os.path.join(self.dir, 'configure.log'), 20000).splitlines()):
            if line.strip():
                m['configure_last'] = line.strip()
                break
        if self.demo:
            m['runner'] = self.demo.runner_info(now)
            v = self.sys.vitals() if self.sys and os.path.exists(os.path.join(self.sys.proc, 'stat')) else None
            m['vitals'] = v if v and v.get('cores') else self.demo.vitals(now)
            m['ccache'] = self.demo.ccache()
        else:
            try:
                m['runner'] = self.sys.runner_info()
            except Exception:
                m['runner'] = {'state': '?'}
            try:
                m['vitals'] = self.sys.vitals()
            except Exception:
                m['vitals'] = {}
            m['ccache'] = self.sys.ccache.get(now)
        return m

    def log_tail(self, n):
        cur = None
        best = (0, None)
        for name in ('configure.log', 'build.log', 'ctest.log'):
            p = os.path.join(self.dir, name)
            try:
                mt = os.path.getmtime(p)
                if os.path.getsize(p) > 0 and mt >= best[0]:
                    best = (mt, name)
            except Exception:
                pass
        cur = best[1]
        if not cur:
            return '(no log yet)', []
        lines = read_tail(os.path.join(self.dir, cur), 400000).splitlines()
        return cur, lines[-n:]


