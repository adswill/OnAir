#!/usr/bin/env python3
# OnAir laptop worker monitor: a live retro dashboard of what the laptop runner is building and testing.
# Runs inside WSL (Ubuntu-24.04, user onair), started by OnAir-Monitor.cmd on Windows. Python 3 stdlib only,
# plain ANSI escape sequences (no curses). It only READS files: ~/onair-monitor/state/*, the runner's _diag logs,
# /proc and /sys, plus `ccache -s` and `nvidia-smi`. It needs no token and never writes outside ~/onair-monitor.
#
#   python3 monitor.py              live view (q quit, l log lines, h history, any other key back)
#   python3 monitor.py --demo       animated fake build + test run (preview on any machine)
#   python3 monitor.py --ascii      plain ASCII instead of box drawing and block characters
#   python3 monitor.py --state DIR  read the state files from DIR (default ~/onair-monitor/state)
#   python3 monitor.py --dump FILE --size 120x40 [--demo --demo-at 30] [--ansi]   render one frame to a file
# Source: tools/laptop-installer/monitor/monitor.py in adswill/OnAir. ASCII-only source file.
import json, os, re, select, shutil, signal, subprocess, sys, tempfile, time

VERSION = 1

HOME = os.path.expanduser('~')
MON_DIR = os.path.join(HOME, 'onair-monitor')

# ------------------------------------------------------------------ glyphs
G_H, G_V = '\u2550', '\u2551'
G_TL, G_TR, G_BL, G_BR = '\u2554', '\u2557', '\u255a', '\u255d'
G_FULL, G_EMPTY, G_MID, G_DARK = '\u2588', '\u2591', '\u2592', '\u2593'
G_VBARS = ' \u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588'
G_UP, G_LO = '\u2580', '\u2584'
G_DONE, G_RUN, G_TODO, G_DOT, G_BUL = '\u221a', '\u00bb', '\u00b7', '\u00b7', '\u25cf'
G_SEP = '\u2502'

ASCII_MAP = {
    G_H: '=', G_V: '|', G_TL: '+', G_TR: '+', G_BL: '+', G_BR: '+',
    G_FULL: '#', G_EMPTY: '-', G_MID: '=', G_DARK: '#', G_UP: '"', G_LO: '_',
    G_DONE: '+', G_RUN: '>', G_TODO: '.', G_BUL: '*', G_SEP: '|',
}
ASCII_TABLE = {ord(k): v for k, v in ASCII_MAP.items()}
ASCII_VBARS = ' .:-=+*%#'
OPTS = {'ascii': False}

# ------------------------------------------------------------------ colours (ANSI 256 on black)
BG = '48;5;16'


def sty(fg, bold=False, bg=None):
    return '\x1b[0;%s38;5;%d;%sm' % ('1;' if bold else '', fg, ('48;5;%d' % bg) if bg is not None else BG)


S_TXT = sty(252)
S_DIM = sty(242)
S_LBL = sty(37)
S_CYAN = sty(51, True)
S_AMB = sty(214, True)
S_AMB2 = sty(172)
S_RED = sty(196, True)
S_GRN = sty(46, True)
S_BORDER = sty(30)
S_TITLE = sty(214, True)
S_BAR_C = sty(44)
S_BAR_A = sty(214)
S_BAR_E = sty(238)
S_STATUS = sty(16, True, 214)
S_STATUS2 = sty(16, False, 37)
GRAD = [51, 51, 87, 123, 159, 195, 230, 229, 228, 221, 220, 214, 214, 208]

# ------------------------------------------------------------------ text lines = lists of (style, text)


def llen(line):
    return sum(len(t) for _, t in line)


def fit(line, w, fill_style=S_TXT):
    out, n = [], 0
    for s, t in line:
        if n >= w:
            break
        if n + len(t) > w:
            t = t[:w - n]
        out.append((s, t))
        n += len(t)
    if n < w:
        out.append((fill_style, ' ' * (w - n)))
    return out


def T(text, s=S_TXT):
    return [(s, str(text))]


def cat(*parts):
    out = []
    for p in parts:
        if isinstance(p, tuple):
            out.append(p)
        elif isinstance(p, list):
            out.extend(p)
        elif p:
            out.append((S_TXT, str(p)))
    return out


def panel(title, lines, w, h, title_style=S_TITLE):
    if h < 2 or w < 4:
        return [fit([], w)] * max(h, 0)
    top = [(S_BORDER, G_TL + G_H), (title_style, ' ' + title + ' ')]
    top = fit(top, w - 1, S_BORDER)
    top = [(s, t) if s is not S_BORDER else (s, t.replace(' ', G_H)) for s, t in top]
    top.append((S_BORDER, G_TR))
    out = [top]
    for i in range(h - 2):
        ln = lines[i] if i < len(lines) else []
        out.append([(S_BORDER, G_V)] + fit(ln, w - 2) + [(S_BORDER, G_V)])
    out.append([(S_BORDER, G_BL + G_H * (w - 2) + G_BR)])
    return out


def hstack(a, b):
    n = max(len(a), len(b))
    return [(a[i] if i < len(a) else []) + (b[i] if i < len(b) else []) for i in range(n)]


def bar(frac, w, s_fill=S_BAR_C, brackets=True, pct=True):
    w = max(w, 3)
    if frac is None:
        inner = [(S_DIM, '?' * w)]
        p = '  ?%'
    else:
        f = min(max(frac, 0.0), 1.0)
        n = int(round(f * w))
        inner = [(s_fill, G_FULL * n), (S_BAR_E, G_EMPTY * (w - n))]
        p = '%3d%%' % int(f * 100)
    out = ([(S_DIM, '[')] if brackets else []) + inner + ([(S_DIM, ']')] if brackets else [])
    if pct:
        out.append((S_TXT, ' ' + p))
    return out


def sweep_bar(w, t):
    # indeterminate bar for phases without a count: a block moving left to right (no blinking)
    w = max(w, 3)
    pos = int(t * 6) % (w + 3)
    cells = []
    for i in range(w):
        d = pos - i
        cells.append(G_FULL if d == 0 else G_DARK if d == 1 else G_MID if d == 2 else G_EMPTY)
    return [(S_DIM, '[')] + [(S_BAR_A if c != G_EMPTY else S_BAR_E, c) for c in cells] + [(S_DIM, ']'), (S_TXT, '  ..')]


def level_style(f):
    if f is None:
        return S_DIM
    return S_GRN if f < 0.5 else S_AMB if f < 0.85 else S_RED


# ------------------------------------------------------------------ formatting


def fmt_dur(s):
    try:
        s = int(max(float(s), 0))
    except Exception:
        return '--:--'
    if s >= 3600:
        return '%d:%02d:%02d' % (s // 3600, (s // 60) % 60, s % 60)
    return '%02d:%02d' % (s // 60, s % 60)


def fmt_up(s):
    try:
        s = int(float(s))
    except Exception:
        return '?'
    if s >= 86400:
        return '%dd %02dh' % (s // 86400, (s // 3600) % 24)
    if s >= 3600:
        return '%dh %02dm' % (s // 3600, (s // 60) % 60)
    if s >= 60:
        return '%dm %02ds' % (s // 60, s % 60)
    return '%ds' % s


def fmt_when(ts):
    try:
        return time.strftime('%m-%d %H:%M', time.localtime(int(ts)))
    except Exception:
        return '?'


def gb(x):
    if x is None:
        return '?'
    g = x / float(1 << 30)
    return ('%d' % round(g)) if g >= 100 else ('%.1f' % g)


def short(p, w):
    p = str(p)
    if len(p) <= w:
        return p
    return '~' + p[-(w - 1):] if w > 1 else p[:w]


def rshort(p, w):
    p = str(p)
    return p if len(p) <= w else (p[:w - 1] + '~' if w > 1 else p[:w])


# ------------------------------------------------------------------ parsers (pure, unit-tested)
NINJA_RE = re.compile(r'^\[(\d+)/(\d+)(?:\s+([\d.]+)s)?\]\s*(.*)$')


def parse_ninja(text):
    """Ninja output with NINJA_STATUS='[%f/%t %es] '. Returns done, total, elapsed, last, state, error, failed."""
    r = {'done': None, 'total': None, 'elapsed': None, 'last': '', 'state': 'none', 'error': '', 'failed': 0,
         'samples': []}
    for line in text.splitlines():
        line = line.rstrip('\r')
        m = NINJA_RE.match(line)
        if m:
            r['done'], r['total'] = int(m.group(1)), int(m.group(2))
            if m.group(3):
                try:
                    r['elapsed'] = float(m.group(3))
                    r['samples'].append((r['elapsed'], r['done']))
                except ValueError:
                    pass
            r['last'] = m.group(4)
            r['state'] = 'running'
        elif line.startswith('FAILED:'):
            r['failed'] += 1
        elif line.startswith('ninja: no work to do'):
            r['state'] = 'uptodate'
        elif line.startswith('ninja: build stopped'):
            r['state'] = 'failed'
        elif not r['error'] and re.search(r'(\berror\b|\berror:)', line) and not line.startswith('[') \
                and 'Werror' not in line:
            r['error'] = line.strip()
    if r['state'] == 'running' and r['done'] is not None and r['done'] == r['total'] and not r['failed']:
        r['state'] = 'done'
    if r['failed'] and r['state'] != 'failed':
        r['state'] = 'failed' if r['state'] != 'running' else 'running'
    r['samples'] = r['samples'][-400:]
    return r


CTEST_RE = re.compile(r'^\s*(\d+)/(\d+)\s+Test\s+#\s*(\d+):\s+(.*?)\s+([\d.]+)\s+sec\s*$')
CTEST_ERR_RE = re.compile(r'(error|fail|assert|abort|exception|what\(\)|segmentation|timeout)', re.I)
TIER_RE = re.compile(r'^=+\s*ONAIR TIER\s+(\S+)')


def parse_ctest_line(line):
    m = CTEST_RE.match(line)
    if not m:
        return None
    n, total, num, body, secs = m.groups()
    k = body.find('***')
    if k >= 0:
        namepart, status = body[:k], body[k + 3:].strip()
    else:
        mm = re.match(r'^(.*?)[\s.]*(Passed|Not Run|Skipped|Disabled|Failed)\s*$', body)
        if mm:
            namepart, status = mm.group(1), mm.group(2)
        else:
            namepart, status = body, '?'
    parts = namepart.strip().split()
    name = parts[0].rstrip('.') if parts else '?'
    st = status.lower()
    if st.startswith('passed'):
        res = 'PASS'
    elif 'skip' in st or 'disabled' in st:
        res = 'SKIP'
    elif 'not run' in st:
        res = 'NOTRUN'
    elif 'timeout' in st:
        res = 'TIMEOUT'
    else:
        res = 'FAIL'
    return {'n': int(n), 'total': int(total), 'num': int(num), 'name': name, 'result': res,
            'secs': float(secs), 'error': ''}


def parse_ctest(text):
    """ctest --output-on-failure output. Returns done, total, results, failures, summary, tier."""
    r = {'done': None, 'total': None, 'results': [], 'summary': '', 'tier': '', 'passed': 0, 'failed': 0,
         'skipped': 0, 'nofound': False}
    pending = None
    for line in text.splitlines():
        line = line.rstrip('\r')
        t = TIER_RE.match(line)
        if t:
            r['tier'] = t.group(1)
            r['done'], r['total'] = 0, None
            pending = None
            continue
        res = parse_ctest_line(line)
        if res:
            res['tier'] = r['tier']
            r['results'].append(res)
            r['done'], r['total'] = res['n'], res['total']
            if res['result'] == 'PASS':
                r['passed'] += 1
            elif res['result'] in ('SKIP', 'NOTRUN') and res['result'] == 'SKIP':
                r['skipped'] += 1
            else:
                r['failed'] += 1
            pending = res if res['result'] not in ('PASS', 'SKIP') else None
            continue
        if re.match(r'^\s*Start\s+\d+:', line):
            pending = None
            continue
        if re.match(r'^\s*\d+% tests passed', line):
            r['summary'] = line.strip()
            pending = None
            continue
        if 'No tests were found' in line:
            r['nofound'] = True
        if pending is not None and line.strip():
            if not pending['error'] or (not pending.get('_err') and CTEST_ERR_RE.search(line)):
                pending['error'] = line.strip()
                if CTEST_ERR_RE.search(line):
                    pending['_err'] = True
    for x in r['results']:
        x.pop('_err', None)
    return r


def parse_nvidia(text):
    """nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu
    --format=csv,noheader,nounits  ->  list of dicts (MiB for memory)."""
    out = []

    def num(v):
        try:
            return float(v)
        except ValueError:
            return None
    for line in text.splitlines():
        p = [x.strip() for x in line.split(',')]
        if len(p) < 5 or not p[0]:
            continue
        out.append({'name': p[0], 'util': num(p[1]), 'mem_used': num(p[2]), 'mem_total': num(p[3]),
                    'temp': num(p[4])})
    return out


def parse_ccache(text):
    r = {'hits': None, 'misses': None, 'size': None, 'max': None}
    for line in text.splitlines():
        m = re.match(r'^\s*Hits:\s+(\d+)', line)
        if m and r['hits'] is None:
            r['hits'] = int(m.group(1))
        m = re.match(r'^\s*Misses:\s+(\d+)', line)
        if m and r['misses'] is None:
            r['misses'] = int(m.group(1))
        m = re.match(r'^\s*Cache size \(GB\):\s+([\d.]+)(?:\s*/\s*([\d.]+))?', line)
        if m:
            r['size'] = float(m.group(1))
            if m.group(2):
                r['max'] = float(m.group(2))
        m = re.match(r'^\s*cache hit \((direct|preprocessed)\)\s+(\d+)', line)  # ccache 3.x
        if m:
            r['hits'] = (r['hits'] or 0) + int(m.group(2))
        m = re.match(r'^\s*cache miss\s+(\d+)', line)
        if m:
            r['misses'] = int(m.group(1))
    return r


def parse_runner_log(text):
    """Runner_*.log of the actions runner -> ('busy'|'idle'|'?', job name, last line)."""
    state, job, last = '?', '', ''
    for line in text.splitlines():
        if 'Running job:' in line:
            state, job = 'busy', line.split('Running job:', 1)[1].strip()
            last = line
        elif 'completed with result:' in line:
            state = 'idle'
            last = line
        elif 'Listening for Jobs' in line:
            if state != 'busy':
                state = 'idle'
            last = line
    return state, job, last


def parse_proc_stat(text):
    cores = []
    total = None
    for line in text.splitlines():
        if not line.startswith('cpu'):
            continue
        p = line.split()
        try:
            v = [int(x) for x in p[1:]]
        except ValueError:
            continue
        idle = v[3] + (v[4] if len(v) > 4 else 0)
        rec = (sum(v[:8]), idle)
        if p[0] == 'cpu':
            total = rec
        else:
            cores.append(rec)
    return total, cores


def parse_meminfo(text):
    d = {}
    for line in text.splitlines():
        m = re.match(r'^(\w+):\s+(\d+)', line)
        if m:
            d[m.group(1)] = int(m.group(2)) * 1024
    return d


SRC_EXT = ('.c', '.cc', '.cpp', '.cxx', '.c++', '.rs', '.m', '.mm', '.cu')
COMPILERS = ('cc1plus', 'cc1', 'c++', 'g++', 'gcc', 'cc', 'clang', 'clang++', 'rustc', 'nvcc')


def sources_in_cmdline(args):
    if not args:
        return None
    exe = os.path.basename(args[0])
    if exe == 'ccache' and len(args) > 1:
        exe = os.path.basename(args[1])
    if not (exe in COMPILERS or re.match(r'^(g\+\+|gcc|clang\+\+|clang|c\+\+)-\d+$', exe) or
            re.match(r'^x86_64-linux-gnu-(g\+\+|gcc)', exe)):
        return None
    for a in args[1:]:
        if a.lower().endswith(SRC_EXT) and not a.startswith('-'):
            return a
    return None


# ------------------------------------------------------------------ data sources


def read_tail(path, limit=2000000):
    try:
        with open(path, 'rb') as f:
            f.seek(0, 2)
            n = f.tell()
            f.seek(max(0, n - limit))
            return f.read().decode('utf-8', 'replace')
    except Exception:
        return ''


def read_json(path, default=None):
    try:
        with open(path, 'r', encoding='utf-8-sig') as f:
            return json.load(f)
    except Exception:
        return default


class Cached:
    """Reparse a file only when its size or mtime changed."""

    def __init__(self, parser, limit=2000000):
        self.parser, self.limit, self.key, self.val = parser, limit, None, None

    def get(self, path):
        try:
            st = os.stat(path)
            key = (st.st_size, st.st_mtime)
        except Exception:
            key = None
        if key != self.key or self.val is None:
            self.key = key
            try:
                self.val = self.parser(read_tail(path, self.limit) if key else '')
            except Exception:
                self.val = self.parser('')
            if isinstance(self.val, dict):
                self.val['mtime'] = key[1] if key else None
        return self.val


def run_cmd(cmd, timeout=3):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=timeout)
        return p.stdout.decode('utf-8', 'replace')
    except Exception:
        return None


class Every:
    def __init__(self, secs, fn):
        self.secs, self.fn, self.t, self.val = secs, fn, 0.0, None

    def get(self, now):
        if now - self.t >= self.secs:
            self.t = now
            try:
                self.val = self.fn()
            except Exception:
                self.val = None
        return self.val


class Sys:
    """Vitals and runner info from /proc, /sys and the runner directory."""

    def __init__(self, proc='/proc', sysd='/sys', runner=None):
        self.proc, self.sysd = proc, sysd
        self.runner = runner or self.find_runner()
        self.prev = None
        self.cpu = (None, [])
        self.nvsmi = shutil.which('nvidia-smi') or ('/usr/lib/wsl/lib/nvidia-smi'
                                                    if os.path.exists('/usr/lib/wsl/lib/nvidia-smi') else None)
        self.gpu = Every(3.0, self._gpu)
        self.ccache = Every(5.0, self._ccache)
        self.svc = Every(4.0, self._svc)
        self.procs = Every(1.0, self._procs)
        self.diag = Every(2.0, self._diag)

    @staticmethod
    def find_runner():
        for d in (os.path.join(HOME, 'actions-runner'), '/home/onair/actions-runner'):
            if os.path.isdir(d):
                return d
        return os.path.join(HOME, 'actions-runner')

    def read(self, rel):
        try:
            with open(os.path.join(self.proc, rel), 'r') as f:
                return f.read()
        except Exception:
            return ''

    def vitals(self):
        v = {}
        total, cores = parse_proc_stat(self.read('stat'))
        if self.prev and cores and len(self.prev[1]) == len(cores):
            def use(a, b):
                dt, di = b[0] - a[0], b[1] - a[1]
                return None if dt <= 0 else max(0.0, min(1.0, 1.0 - di / dt))
            self.cpu = (use(self.prev[0], total) if total and self.prev[0] else None,
                        [use(a, b) for a, b in zip(self.prev[1], cores)])
        self.prev = (total, cores)
        v['cpu_total'], v['cores'] = self.cpu
        if not v['cores'] and cores:
            v['cores'] = [None] * len(cores)
        mi = parse_meminfo(self.read('meminfo'))
        v['mem_total'] = mi.get('MemTotal')
        v['mem_used'] = (mi['MemTotal'] - mi.get('MemAvailable', mi.get('MemFree', 0))) if 'MemTotal' in mi else None
        v['swap_total'] = mi.get('SwapTotal')
        v['swap_used'] = (mi['SwapTotal'] - mi.get('SwapFree', 0)) if 'SwapTotal' in mi else None
        la = self.read('loadavg').split()
        v['load'] = ' '.join(la[:3]) if len(la) >= 3 else '?'
        up = self.read('uptime').split()
        v['uptime'] = float(up[0]) if up else None
        v['disk_wsl'] = self.disk('/')
        v['disk_c'] = self.disk('/mnt/c') if os.path.isdir('/mnt/c') else None
        v['temp'] = self.temp()
        v['gpu'] = self.gpu.get(time.time())
        return v

    @staticmethod
    def disk(path):
        try:
            s = os.statvfs(path)
            tot = s.f_blocks * s.f_frsize
            free = s.f_bavail * s.f_frsize
            return (tot - free, tot) if tot > 0 else None
        except Exception:
            return None

    def temp(self):
        best = None
        try:
            base = os.path.join(self.sysd, 'class', 'thermal')
            for n in os.listdir(base):
                if n.startswith('thermal_zone'):
                    try:
                        with open(os.path.join(base, n, 'temp')) as f:
                            t = int(f.read().strip()) / 1000.0
                        if 0 < t < 130:
                            best = t if best is None else max(best, t)
                    except Exception:
                        pass
        except Exception:
            pass
        return best

    def _gpu(self):
        if not self.nvsmi:
            return None
        out = run_cmd([self.nvsmi, '--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu',
                       '--format=csv,noheader,nounits'], 3)
        g = parse_nvidia(out or '')
        return g[0] if g else None

    def _ccache(self):
        if not shutil.which('ccache'):
            return None
        return parse_ccache(run_cmd(['ccache', '-s'], 3) or '')

    def _svc(self):
        name = ''
        try:
            with open(os.path.join(self.runner, '.service')) as f:
                name = f.read().strip()
        except Exception:
            pass
        if not name or not shutil.which('systemctl'):
            return (name, None)
        out = run_cmd(['systemctl', 'is-active', name], 3)
        return (name, (out or '').strip() or None)

    def _procs(self):
        listener = worker = None
        comp = []
        hz = os.sysconf('SC_CLK_TCK') if hasattr(os, 'sysconf') else 100
        try:
            pids = [p for p in os.listdir(self.proc) if p.isdigit()]
        except Exception:
            pids = []
        for pid in pids:
            try:
                with open(os.path.join(self.proc, pid, 'cmdline'), 'rb') as f:
                    args = [a.decode('utf-8', 'replace') for a in f.read().split(b'\0') if a]
            except Exception:
                continue
            if not args:
                continue
            joined = ' '.join(args[:2])
            if 'Runner.Listener' in joined:
                listener = pid
            elif 'Runner.Worker' in joined:
                worker = pid
            src = sources_in_cmdline(args)
            if src:
                comp.append((self.start_secs(pid, hz), src))
        seen, files = set(), []
        for st, src in sorted(comp, key=lambda x: x[0] or 0):
            key = '/'.join(src.replace('\\', '/').split('/')[-3:])
            if key not in seen:
                seen.add(key)
                files.append((st, src))
        return {'listener': listener, 'worker': worker, 'compiling': files,
                'listener_start': self.start_secs(listener, hz) if listener else None}

    def start_secs(self, pid, hz):
        try:
            with open(os.path.join(self.proc, pid, 'stat')) as f:
                s = f.read()
            fields = s[s.rfind(')') + 2:].split()
            return int(fields[19]) / float(hz)
        except Exception:
            return None

    def _diag(self):
        d = os.path.join(self.runner, '_diag')
        try:
            logs = sorted((os.path.getmtime(os.path.join(d, n)), n) for n in os.listdir(d) if n.startswith('Runner_'))
        except Exception:
            logs = []
        if not logs:
            return ('?', '', '', None)
        st, job, last = parse_runner_log(read_tail(os.path.join(d, logs[-1][1]), 300000))
        return (st, job, last, logs[-1][0])

    def runner_info(self):
        now = time.time()
        svc, active = self.svc.get(now) or ('', None)
        pr = self.procs.get(now) or {}
        diag = self.diag.get(now) or ('?', '', '', None)
        name = ''
        j = read_json(os.path.join(self.runner, '.runner'), {}) or {}
        if isinstance(j, dict):
            name = j.get('agentName', '') or ''
        up = None
        try:
            sysup = float(self.read('uptime').split()[0])
            if pr.get('listener_start') is not None:
                up = sysup - pr['listener_start']
        except Exception:
            pass
        if pr.get('listener') is None and active not in ('active',):
            state = 'OFFLINE'
        elif pr.get('worker') or diag[0] == 'busy':
            state = 'BUSY'
        else:
            state = 'IDLE'
        if pr.get('listener') is None and active is None and diag[0] == '?':
            state = 'OFFLINE'
        return {'state': state, 'service': svc, 'active': active, 'name': name or 'onair-laptop',
                'uptime': up, 'diag_state': diag[0], 'diag_job': diag[1], 'diag_last': diag[2],
                'diag_time': diag[3], 'compiling': pr.get('compiling', []), 'dir': self.runner}


