        else:
            self._write('configure.log', '')
        # build log
        lines = []
        if t >= 9:
            bt = min(t, 55) - 9
            done = int(self.N_FILES * min(1.0, (bt / 46.0) ** 0.9))
            for i in range(1, done + 1):
                f = DEMO_FILES[i % len(DEMO_FILES)]
