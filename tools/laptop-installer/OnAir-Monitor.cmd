def big_text(s):
    rows = [[], []]
    col = 0
    for ch in s:
        g = FONT.get(ch, FONT[' '])
        for r in range(2):
            rows[r].append((col, g[r] + ' '))
        col += len(g[0]) + 1
    out = []
    for r in range(2):
        line = []
        for i, (c, txt) in enumerate(rows[r]):
            line.append((sty(GRAD[min(len(GRAD) - 1, c * len(GRAD) // max(col, 1))], True), txt))
        out.append(line)
    return out, col


def job_elapsed(job, now):
    try:
        return now - float(job.get('started'))
    except Exception:
        return None


def render_header(m, w, big):
    job, run = m.get('job'), m.get('runner') or {}
    state = run.get('state', '?')
    if state != 'OFFLINE' and job:
        state = 'BUSY'
    lines = []
    clock = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(m['now']))
    if big:
        bt, bw = big_text('ONAIR LAPTOP WORKER')
        right1 = '%s  %s' % (G_DOT * 3, clock)
        right2 = 'v%d %s' % (VERSION, G_DOT * 3)
        lines.append(cat((S_TXT, ' '), bt[0], (S_DIM, ' ' * max(0, w - bw - 2 - len(right1)) + right1)))
        lines.append(cat((S_TXT, ' '), bt[1], (S_DIM, ' ' * max(0, w - bw - 2 - len(right2)) + right2)))
    st_style = {'BUSY': S_STATUS, 'IDLE': sty(16, True, 46), 'OFFLINE': sty(231, True, 160)}.get(state, S_STATUS2)
    if job:
        what = ' %s %s@%s  %s  %s ' % (G_RUN, job.get('ref', '?'), str(job.get('sha', ''))[:7] or '?',
                                       job.get('phase', '') or '?', fmt_dur(job_elapsed(job, m['now'])))
    elif state == 'OFFLINE':
        what = ' runner is not running '
    else:
        what = ' IDLE: waiting for jobs '
    left = [(st_style, ' %s %s ' % (G_BUL, state)), (S_STATUS2, what)]
    if not big:
        left = [(S_STATUS, ' ONAIR LAPTOP WORKER ')] + left
    up = (m.get('vitals') or {}).get('uptime')
    right = ' WSL up %s %s %s ' % (fmt_up(up), G_SEP, time.strftime('%H:%M:%S', time.localtime(m['now'])))
    fill = w - llen(left) - len(right)
    lines.append(left + [(sty(16, False, 30), ' ' * max(0, fill)), (S_STATUS2, right)])
    return lines


def phase_rows(job, m, w):
    now = m['now']
    rows = []
    plist = job.get('phase_list') or ['checkout', 'configure', 'build', 'test', 'summary']
    recs = {}
    for p in job.get('phases') or []:
        if isinstance(p, dict) and p.get('name'):
            recs[p['name']] = p
    for name in plist:
        p = recs.get(name)
        bw = max(8, w - 30)
        if p is None:
            skipped = name.startswith('test') and not job.get('tests') and job.get('workflow') != 'Full test'
            rows.append(cat((S_DIM, ' %s %-10s ' % (G_TODO, name)), bar(0.0, bw, pct=False),
                            (S_DIM, '  skipped' if skipped else '  waiting')))
            continue
        try:
            st, en = float(p.get('start')), p.get('end')
            dur = (float(en) if en is not None else now) - st
        except Exception:
            st, en, dur = None, None, None
        if en is not None:
            rows.append(cat((S_GRN, ' %s ' % G_DONE), (S_TXT, '%-10s ' % name), bar(1.0, bw, S_BAR_C, pct=False),
                            (S_DIM, '  %s' % fmt_dur(dur))))
            continue
        frac = None
        if name == 'build':
            b = m.get('build') or {}
            if b.get('total'):
                frac = b['done'] / float(b['total'])
        elif name.startswith('test'):
            c = m.get('ctest') or {}
            if c.get('total'):
                frac = (c.get('done') or 0) / float(c['total'])
        lead = cat((S_AMB, ' %s ' % G_RUN), (S_AMB, '%-10s ' % name))
        if frac is None:
            rows.append(lead + sweep_bar(bw, now)[:-1] + [(S_AMB, '  %s' % fmt_dur(dur))])
        else:
            rows.append(lead + bar(frac, bw, S_BAR_A, pct=False) +
                        [(S_AMB, ' %3d%%' % int(frac * 100)), (S_DIM, ' %s' % fmt_dur(dur))])
    return rows


def render_job(m, w, h):
    job = m.get('job')
    inner = w - 2
    lines = []
    if not job:
        run = m.get('runner') or {}
        if run.get('state') == 'OFFLINE':
            lines.append(T('  RUNNER OFFLINE', S_RED))
            lines.append(T('  The runner service is not running. Log in to', S_TXT))
            lines.append(T('  Windows or run OnAir-Laptop-Setup.cmd again.', S_TXT))
        else:
            dots = G_DOT * (1 + int(m['now']) % 3)
            lines.append(T('  IDLE: waiting for jobs ' + dots, S_CYAN))
            lines.append(T('  Nothing is building. Jobs come from the Mac', S_DIM))
            lines.append(T('  (dispatch_laptop.sh) or the Actions tab of OnAir-ci.', S_DIM))
        hist = m.get('history') or []
        if hist:
            last = hist[-1]
            res = str(last.get('result', '?'))
            lines.append([])
            lines.append(cat((S_LBL, '  last job  '), (S_TXT, '%s@%s  ' % (last.get('ref', '?'), str(last.get('sha', ''))[:7])),
                             (S_GRN if res == 'PASS' else S_RED if res == 'FAIL' else S_AMB, res),
                             (S_DIM, '  %s  %s' % (fmt_dur(last.get('duration')), fmt_when(last.get('started')))))
            )
        return panel('CURRENT JOB', lines, w, h)
    sha = str(job.get('sha', ''))[:7] or '?'
    lines.append(cat((S_LBL, ' ref     '), (S_CYAN, str(job.get('ref', '?'))), (S_DIM, ' @ '), (S_AMB, sha),
                     (S_DIM, '   %s   total ' % job.get('workflow', '')), (S_TXT, fmt_dur(job_elapsed(job, m['now'])))))
    tg = job.get('targets') or '(everything)'
    ts = job.get('tests') or '(none)'
    lines.append(cat((S_LBL, ' targets '), (S_TXT, rshort(tg, max(10, inner // 2 - 9))), (S_LBL, '   tests '), (S_TXT, ts)))
    if h - 2 >= 3 + len(job.get('phase_list') or [1] * 5) + 1:
        lines.append(cat((S_LBL, ' run     '), (S_DIM, short(job.get('run_url', '') or '?', inner - 10))))
    lines.extend(phase_rows(job, m, inner))
    extra = ''
    if job.get('phase') == 'configure':
        extra = m.get('configure_last', '')
    elif job.get('phase') == 'build':
        extra = (m.get('build') or {}).get('last', '')
    if extra and len(lines) < h - 2:
        lines.append(cat((S_DIM, ' > '), (S_DIM, short(extra, inner - 4))))
    return panel('CURRENT JOB', lines, w, h)


def build_rate(b, now):
    s = b.get('samples') or []
    if len(s) < 2:
        return None
    t_end, d_end = s[-1]
    for t, d in reversed(s):
        if t_end - t >= 20:
            break
    if t_end - t <= 0:
        t, d = s[0]
    if t_end - t <= 0:
        return None
    return (d_end - d) / (t_end - t)


