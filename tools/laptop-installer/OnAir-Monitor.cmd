            tl.append('Test project /home/onair/actions-runner/_work/OnAir-ci/OnAir-ci/src/build-main')
            for i in range(1, n + 1):
                name = '%s_%02d' % (DEMO_TESTS[i % len(DEMO_TESTS)], i)
                tl.append('      Start %3d: %s' % (i, name))
                if i in (37, 71):
                    tl.append('%3d/%d Test #%d: %s %s***Failed    %.2f sec' % (i, self.N_TESTS, i, name,
                                                                                '.' * max(3, 40 - len(name)), 1.5 + i / 50.0))
                    tl.append('[ RUN      ] %s.decodes_frame' % name)
                    tl.append('core/tests/%s.cpp:%d: error: expected BER < 1e-4, got 3.2e-3' % (name, 100 + i))
                else:
                    tl.append('%3d/%d Test #%d: %s %s   Passed    %.2f sec' % (i, self.N_TESTS, i, name,
                                                                              '.' * max(3, 40 - len(name)), (i % 7) * 0.31 + 0.05))
            if t >= 88:
                tl.append('')
                tl.append('98% tests passed, 2 tests failed out of 96')
        self._write('ctest.log', '\n'.join(tl) + ('\n' if tl else ''))

