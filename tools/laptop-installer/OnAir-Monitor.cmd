    def tick(self, now):
        t = (now - self.t0) % self.PERIOD
        cyc = int((now - self.t0) // self.PERIOD)
        started = self.t0 + cyc * self.PERIOD
        if cyc != self.cycle and self.cycle >= 0:
            pass
        self.cycle = cyc
        phases_t = [('checkout', 0, 4), ('configure', 4, 9), ('build', 9, 55), ('test', 55, 88),
                    ('summary', 88, 92)]
        self.t = t
        if t >= 92:
            if os.path.exists(os.path.join(self.dir, 'current.json')):
                os.remove(os.path.join(self.dir, 'current.json'))
                h = self.history + [{'workflow': 'Build and test', 'ref': 'laptop-monitor-030', 'sha': 'c028cb7',
                                     'result': 'FAIL', 'duration': 92, 'started': int(started),
                                     'run_url': ''}]
                self.history = h[-50:]
                self._write('history.json', json.dumps(self.history))
            self.phase = None
            return
        phases, cur_phase = [], ''
        for name, a, b in phases_t:
            if t >= a:
                phases.append({'name': name, 'start': int(started + a), 'end': int(started + b) if t >= b else None})
                cur_phase = name
        self.phase = cur_phase
        cur = {'workflow': 'Build and test', 'ref': 'laptop-monitor-030', 'sha': 'c028cb7',
               'targets': 'dect2_core dect2_tests', 'tests': '^(dvbt2|ofdm|fm)_', 'started': int(started),
