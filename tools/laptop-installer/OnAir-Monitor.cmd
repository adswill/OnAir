        lines.append(T('  no build output yet' if job else '  no build since the monitor was installed', S_DIM))
    else:
        frac = (done / float(total)) if total else (1.0 if b.get('state') == 'uptodate' else None)
        s_fill = S_BAR_A if not stale else S_BAR_C
        if b.get('state') == 'failed':
            s_fill = sty(160)
        lines.append(cat((S_TXT, ' '), bar(frac, inner - 24, s_fill), (S_CYAN, '  %s/%s' % (done if done is not None else '?',
                                                                                          total if total is not None else '?'))))
        rate = build_rate(b, m['now'])
        eta = ((total - done) / rate) if (rate and total and done is not None and rate > 0) else None
        word = {'running': 'building', 'done': 'done', 'uptodate': 'up to date', 'failed': 'FAILED'}.get(b.get('state'), '?')
        if stale and word == 'building':
            word = 'stopped'
        lines.append(cat((S_LBL, ' state '), (S_RED if word == 'FAILED' else S_AMB if word == 'building' else S_GRN, '%-10s' % word),
                         (S_LBL, ' rate '), (S_TXT, '%5s/s' % ('%.1f' % rate if rate else '?')),
                         (S_LBL, '  elapsed '), (S_TXT, fmt_dur(b.get('elapsed'))),
                         (S_LBL, '  ETA '), (S_TXT, fmt_dur(eta) if (eta is not None and not stale) else '--:--')))
    cc = m.get('ccache') or {}
    if cc:
        hits, miss = cc.get('hits'), cc.get('misses')
        rate = (hits / float(hits + miss)) if (hits is not None and miss is not None and hits + miss > 0) else None
        lines.append(cat((S_LBL, ' ccache '), (S_TXT, 'hit '), (level_style(None if rate is None else 1 - rate) if rate is not None else S_DIM,
                                                              '%3s%%' % (int(rate * 100) if rate is not None else '?')),
                         (S_DIM, ' (%s hit / %s miss)' % (hits if hits is not None else '?', miss if miss is not None else '?')),
                         (S_LBL, '  size '), (S_TXT, '%s / %s GB' % (cc.get('size') if cc.get('size') is not None else '?',
                                                                   cc.get('max') if cc.get('max') is not None else '?'))))
    else:
        lines.append(T(' ccache ?', S_DIM))
    if b.get('error'):
        lines.append(cat((S_RED, ' error '), (S_RED, short(b['error'], inner - 8))))
    room = h - 2 - len(lines) - 1
    comp = (m.get('runner') or {}).get('compiling') or []
    if room > 0:
        if comp:
            lines.append(T(' compiling now:', S_LBL))
            up = (m.get('vitals') or {}).get('uptime')
            for st, src in comp[-room:]:
                age = ''
                if st is not None and up is not None:
                    age = '%4ds' % max(0, int(up - st)) if not m.get('demo') else '%4ds' % max(0, int(m['now'] - st))
                elif st is not None and m.get('demo'):
                    age = '%4ds' % max(0, int(m['now'] - st))
                fw = inner - 11
                lines.append(cat((S_AMB2, '  %s ' % G_RUN), (S_TXT, '%-*s' % (fw, short(src, fw))), (S_DIM, ' ' + age)))
        elif b.get('last'):
            lines.append(T(' last step:', S_LBL))
            lines.append(cat((S_DIM, '   '), (S_DIM, short(b['last'], inner - 4))))
    return panel('BUILD', lines, w, h)


def render_tests(m, w, h):
    inner = w - 2
    c = m.get('ctest') or {}
    job = m.get('job') or {}
    lines = []
    total, done = c.get('total'), c.get('done')
    if not c.get('results') and not c.get('summary'):
        if job and not job.get('tests') and job.get('workflow') != 'Full test':
            lines.append(T('  this job builds only (no test regex)', S_DIM))
        else:
            lines.append(T('  no tests run yet' if job else '  no test output', S_DIM))
        return panel('TESTS', lines, w, h)
    frac = (done / float(total)) if total else None
    s_fill = S_BAR_C if not c.get('failed') else S_BAR_A
    lines.append(cat((S_TXT, ' '), bar(frac, inner - 24, s_fill), (S_CYAN, '  %s/%s' % (done if done is not None else '?', total or '?'))))
    lines.append(cat((S_LBL, ' pass '), (S_GRN, '%-5d' % c.get('passed', 0)), (S_LBL, ' fail '),
                     (S_RED if c.get('failed') else S_TXT, '%-5d' % c.get('failed', 0)),
                     (S_LBL, ' skip '), (S_TXT, '%-4d' % c.get('skipped', 0)),
                     (S_LBL, ('  tier ' + c['tier']) if c.get('tier') else ''),
                     (S_DIM, ('   ' + c['summary']) if c.get('summary') else '')))
    room = h - 2 - len(lines)
    res = c.get('results') or []
    fails = [r for r in res if r['result'] not in ('PASS', 'SKIP')]
    nf = min(len(fails), max(0, room // 2 // 2))
    fail_rows = []
    for r in fails[-nf:] if nf else []:
        nm_w = inner - 20
        fail_rows.append(cat((S_RED, '  %-7s' % r['result']), (S_RED, '%-*s' % (nm_w, short(r['name'], nm_w))),
                             (S_DIM, '%8.2fs' % r['secs'])))
        fail_rows.append(cat((S_DIM, '      > '), (sty(203), short(r.get('error') or '(no output)', inner - 9))))
    rest = room - len(fail_rows) - (1 if fail_rows else 0)
    recent = []
    for r in res[-max(rest, 0):] if rest > 0 else []:
        ok = r['result'] == 'PASS'
        st = S_GRN if ok else S_DIM if r['result'] == 'SKIP' else S_RED
        nm_w = inner - 20
        recent.append(cat((st, '  %-7s' % r['result']), (S_TXT if ok else st, '%-*s' % (nm_w, short(r['name'], nm_w))),
                          (S_DIM, '%8.2fs' % r['secs'])))
    lines.extend(recent)
    if fail_rows:
        lines.append(T(' failures:', S_RED))
        lines.extend(fail_rows)
    return panel('TESTS', lines, w, h)


def render_runner(m, w, h):
    r = m.get('runner') or {}
    inner = w - 2
    state = r.get('state', '?')
    if state != 'OFFLINE' and m.get('job'):
        state = 'BUSY'
    st = {'BUSY': S_AMB, 'IDLE': S_GRN, 'OFFLINE': S_RED}.get(state, S_DIM)
    lines = [cat((S_LBL, ' state   '), (st, '%-8s' % state), (S_DIM, short(r.get('name', '?'), inner - 18)))]
    act = r.get('active')
    lines.append(cat((S_LBL, ' service '), (S_GRN if act == 'active' else S_RED if act else S_DIM, '%-8s' % (act or '?')),
                     (S_LBL, 'up '), (S_TXT, fmt_up(r.get('uptime')))))
    last = r.get('diag_last') or ''
    m2 = re.search(r'(Running job:.*|completed with result:.*|Listening for Jobs)', last)
    last = m2.group(1) if m2 else (last[-(inner - 10):] if last else '?')
    when = ''
    if r.get('diag_time'):
        when = ' (%s ago)' % fmt_up(m['now'] - r['diag_time'])
    lines.append(cat((S_LBL, ' last    '), (S_TXT, rshort(last, inner - 10 - len(when))), (S_DIM, when)))
    if h - 2 > 3:
        lines.append(cat((S_LBL, ' dir     '), (S_DIM, short(r.get('dir', '?'), inner - 10))))
    return panel('RUNNER', lines, w, h)


def render_vitals(m, w, h):
    v = m.get('vitals') or {}
    inner = w - 2
    lines = []
    cores = v.get('cores') or []
    tot = v.get('cpu_total')
    rows_avail = h - 2
    vrows = 3 if rows_avail >= 12 else 2 if rows_avail >= 9 else 1
    temp = v.get('temp')
    lines.append(cat((S_LBL, ' CPU  '), bar(tot, inner - 30, S_BAR_C), (S_DIM, '  %d thr ' % len(cores)),
                     (S_LBL, 'T '), (level_style(None if temp is None else (temp - 40) / 55.0), ('%2d C' % temp) if temp is not None else ' ? C')))
    if cores:
        gap = 1 if len(cores) * 2 <= inner - 6 else 0
        vb = ASCII_VBARS if OPTS['ascii'] else G_VBARS
        levels = len(vb) - 1
        for row in range(vrows):
            seg = [(S_DIM, '      ')]
            for f in cores:
                if f is None:
                    seg.append((S_DIM, '?' if row == vrows - 1 else ' '))
                else:
                    cells = f * vrows * levels
                    lvl = int(round(cells - (vrows - 1 - row) * levels))
                    lvl = max(0, min(levels, lvl))
                    ch = vb[lvl] if (lvl > 0 or row < vrows - 1) else vb[1]
                    seg.append((level_style(f), ch))
                if gap:
                    seg.append((S_TXT, ' '))
            lines.append(seg)
    else:
        lines.append(T('      per-core load: ?', S_DIM))
    lines.append(cat((S_LBL, ' load '), (S_TXT, v.get('load', '?'))))

    def ratio(used, total):
        return (used / float(total)) if (used is not None and total) else None

    def memline(label, used, total, unit='GB'):
        f = ratio(used, total)
        txt = ' %s/%s %s' % (gb(used), gb(total), unit)
        return cat((S_LBL, label), bar(f, inner - 22, level_style(f) if f is not None and f > 0.85 else S_BAR_C,
                                       pct=False), (S_TXT, '%14s' % txt))
    lines.append(memline(' RAM  ', v.get('mem_used'), v.get('mem_total')))
    lines.append(memline(' SWAP ', v.get('swap_used'), v.get('swap_total')))
    dw, dc = v.get('disk_wsl'), v.get('disk_c')
    lines.append(memline(' WSL  ', dw[0] if dw else None, dw[1] if dw else None))
    lines.append(memline(' C:   ', dc[0] if dc else None, dc[1] if dc else None))
    g = v.get('gpu')
    if g:
        gu = g.get('util')
        gt = g.get('temp')
        lines.append(cat((S_LBL, ' GPU  '), bar(None if gu is None else gu / 100.0, inner - 22, S_BAR_A, pct=False),
                         (S_TXT, '%5s' % ('%d%%' % gu if gu is not None else '?%')),
                         (level_style(None if gt is None else (gt - 40) / 50.0), '%9s' % ('%d C' % gt if gt is not None else '? C'))))
        mu, mt = g.get('mem_used'), g.get('mem_total')
        lines.append(memline(' VRAM ', mu * 1048576 if mu is not None else None, mt * 1048576 if mt is not None else None))
        nm = re.sub(r'^NVIDIA (GeForce )?', '', g.get('name', '') or '')
        if nm:
            lines.append(cat((S_LBL, ' card '), (S_DIM, short(nm, inner - 7))))
    else:
        lines.append(T(' GPU  nvidia-smi not found', S_DIM))
    while len(lines) > rows_avail and len(lines) > 1:
        # drop the least important rows first on small windows
        for key in (' card ', ' load ', ' SWAP '):
            idx = [i for i, ln in enumerate(lines) if ln and ln[0][1] == key]
            if idx:
                lines.pop(idx[0])
                break
        else:
            lines.pop()
    return panel('LAPTOP VITALS', lines, w, h)


def history_row(e, inner, wide=False):
    res = str(e.get('result', '?'))
    rs = S_GRN if res == 'PASS' else S_RED if res == 'FAIL' else S_AMB
    def refsha(n):
        sha = str(e.get('sha', ''))[:7]
        r = str(e.get('ref', '?'))
        room = n - len(sha) - 1
        if len(r) > room:
            r = r[:max(1, room - 1)] + '~'
        return '%s@%s' % (r, sha)
    ref = refsha(36 if wide else max(8, inner - 30))
    if wide:
        wf = str(e.get('workflow', ''))
        return cat((S_DIM, ' %s ' % fmt_when(e.get('started'))), (S_TXT, '%-*s' % (36, short(ref, 36))),
                   (rs, ' %-6s ' % res), (S_TXT, '%8s ' % fmt_dur(e.get('duration'))), (S_LBL, '%-15s ' % short(wf, 15)),
                   (S_DIM, short(e.get('run_url', '') or '', max(1, inner - 84))))
    when = fmt_when(e.get('started'))
    if inner < 46:
        when = when[-5:]
    rw = max(8, inner - 16 - len(when))
    ref = refsha(rw)
    return cat((S_DIM, ' %s ' % when), (S_TXT, '%-*s' % (rw, short(ref, rw))),
               (rs, ' %-6s' % res), (S_TXT, '%7s' % fmt_dur(e.get('duration'))))


def render_history(m, w, h, wide=False):
    inner = w - 2
    hist = list(reversed(m.get('history') or []))
    lines = []
    if not hist:
        lines.append(T('  no jobs recorded yet', S_DIM))
    else:
        if wide:
            lines.append(T(' started     ref@commit                           result   time     workflow        run', S_LBL))
        else:
            lines.append(T(' started     ref@commit' if inner >= 46 else ' time  ref@commit', S_LBL))
        for e in hist[:max(0, h - 3)]:
            lines.append(history_row(e, inner, wide))
    return panel('HISTORY (newest first)', lines, w, h)


def render_log(model, m, w, h):
    name, lines = model.log_tail(max(1, h - 2))
    out = []
    for ln in lines:
        st = S_TXT
        if re.search(r'(error|FAILED|\*\*\*Failed|\*\*\*Timeout)', ln):
            st = S_RED
        elif re.search(r'Passed', ln):
            st = S_GRN
        elif ln.startswith('['):
            st = S_LBL
        out.append(cat((S_DIM, ' '), (st, ln.expandtabs(4))))
    return panel('LOG: %s (last %d lines)' % (name, len(lines)), out, w, h)


def safe(fn, title, w, h, *a):
    try:
        out = fn(*a)
        if len(out) == h and all(llen(x) == w for x in out):
            return out
        return [fit(x, w) for x in (out + [[]] * h)[:h]]
    except Exception as e:  # a broken state file shows '?' in that panel only
        return panel(title, [T(' ? (%s)' % str(e)[:w - 8], S_DIM)], w, h)


def render(model, m, W, H, view='main'):
    if W < 80 or H < 24:
        msg = 'OnAir monitor: window too small (%dx%d), need at least 100x30' % (W, H)
        lines = [fit(T(msg, S_AMB), W)] + [fit([], W)] * (H - 1)
        lines[-1] = fit(lines[-1], W - 1)
        return lines
    big = H >= 36 and W >= 100
    try:
        header = render_header(m, W, big)
    except Exception:
        header = [fit(T(' ONAIR LAPTOP WORKER  ?', S_STATUS), W)]
    footer = cat((S_DIM, ' '), (S_AMB, 'q'), (S_DIM, ' quit  '), (S_AMB, 'l'), (S_DIM, ' log lines  '), (S_AMB, 'h'),
                 (S_DIM, ' history  '), (S_AMB, 'any key'), (S_DIM, ' back   %s 2 Hz%s' % (G_SEP, '' if model.dir == os.path.join(MON_DIR, 'state') else
                                                     ('   state ' + short(model.dir, 40)))))
    body_h = H - len(header) - 1
    if view == 'log':
        body = safe(render_log, 'LOG', W, body_h, model, m, W, body_h)
    elif view == 'history':
        body = safe(render_history, 'HISTORY', W, body_h, m, W, body_h, W >= 110)
    else:
        rw = 48 if W >= 116 else max(40, W * 42 // 100)
        lw = W - rw
        compact = H < 36
        rh = 5 if compact else 6
        vh = 11 if compact else 14
        hh = body_h - rh - vh
        if hh < 5:
            vh = max(8, vh - (5 - hh))
            hh = body_h - rh - vh
        right = (safe(render_runner, 'RUNNER', rw, rh, m, rw, rh) + safe(render_vitals, 'LAPTOP VITALS', rw, vh, m, rw, vh) +
                 safe(render_history, 'HISTORY', rw, hh, m, rw, hh))
        jh = 9 if compact else 11
        bh = 9 if compact else 11
        th = body_h - jh - bh
        if th < 5:
            bh = max(6, bh - (5 - th))
            th = body_h - jh - bh
        left = (safe(render_job, 'CURRENT JOB', lw, jh, m, lw, jh) + safe(render_build, 'BUILD', lw, bh, m, lw, bh) +
                safe(render_tests, 'TESTS', lw, th, m, lw, th))
        body = hstack(left, right)
    lines = header + body[:body_h] + [footer]
    lines = [fit(ln, W) for ln in lines[:H]]
    while len(lines) < H:
        lines.append(fit([], W))
    lines[-1] = fit(lines[-1], W - 1)  # never write the bottom-right cell (avoids a scroll on some consoles)
    return lines


def to_ansi(lines, ascii_mode=False):
    out = []
    for ln in lines:
        s = []
        for st, t in ln:
            if ascii_mode:
                t = t.translate(ASCII_TABLE)
                t = t.encode('ascii', 'replace').decode('ascii')
            s.append(st + t)
        out.append(''.join(s) + '\x1b[0m')
    return out


def to_plain(lines, ascii_mode=False):
    out = []
    for ln in lines:
        t = ''.join(x for _, x in ln)
        if ascii_mode:
            t = t.translate(ASCII_TABLE).encode('ascii', 'replace').decode('ascii')
        out.append(t.rstrip())
    return '\n'.join(out) + '\n'


# ------------------------------------------------------------------ terminal loop


class Term:
    def __init__(self):
        self.fd = sys.stdin.fileno() if sys.stdin.isatty() else None
        self.old = None

    def __enter__(self):
        if self.fd is not None:
            try:
                import termios, tty
                self.old = termios.tcgetattr(self.fd)
                tty.setcbreak(self.fd)
            except Exception:
                self.old = None
        sys.stdout.write('\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[0;%sm\x1b[2J' % BG)
        sys.stdout.flush()
        return self

    def __exit__(self, *a):
        self.restore()

    def restore(self):
        try:
            sys.stdout.write('\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l')
            sys.stdout.flush()
        except Exception:
            pass
        if self.old is not None:
            try:
                import termios
                termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)
            except Exception:
                pass
            self.old = None

    def key(self, timeout):
        if self.fd is None:
            time.sleep(timeout)
            return None
        try:
            r, _, _ = select.select([self.fd], [], [], timeout)
            if r:
                return os.read(self.fd, 32).decode('utf-8', 'replace')
        except InterruptedError:
            return None
        except Exception:
            time.sleep(timeout)
        return None


def run_live(model, ascii_mode, hz=2.0):
    view = 'main'
    last_size = None
    stop = {'v': False}

    def on_term(*a):
        stop['v'] = True
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, on_term)
        except Exception:
            pass
    try:
        signal.signal(signal.SIGWINCH, lambda *a: None)  # wakes select; the size is read every frame
    except Exception:
        pass
    with Term() as term:
        while not stop['v']:
            t_frame = time.time()
            size = shutil.get_terminal_size((120, 40))
            W, H = size.columns, size.lines
            try:
                m = model.collect(t_frame)
                m['demo'] = bool(model.demo)
                lines = to_ansi(render(model, m, W, H, view), ascii_mode)
            except Exception as e:  # never die on bad data: show the problem instead
                lines = to_ansi([fit(T(' monitor error: %s' % e, S_RED), W)] + [fit([], W)] * (H - 1), ascii_mode)
            prefix = '\x1b[H'
            if size != last_size:
                prefix = '\x1b[0;%sm\x1b[2J\x1b[H' % BG
                last_size = size
            frame = prefix + '\r\n'.join(lines) + '\x1b[0;%sm\x1b[J' % BG
            try:
                sys.stdout.write(frame)
                sys.stdout.flush()
            except Exception:
                pass
            wait = max(0.05, 1.0 / hz - (time.time() - t_frame))
            k = term.key(wait)
            if k:
                c = k[:1].lower()
                if c == 'q' or k == '\x03':
                    break
                elif c == 'l':
                    view = 'main' if view == 'log' else 'log'
                elif c == 'h':
                    view = 'main' if view == 'history' else 'history'
                else:
                    view = 'main'


def prefer_installed(argv):
    """Used by OnAir-Monitor.cmd: run ~/onair-monitor/monitor.py if it is newer than this copy, else install this copy."""
    me = os.path.abspath(__file__)
    inst = os.path.join(MON_DIR, 'monitor.py')
    if os.path.abspath(inst) == me:
        return
    iv = -1
    try:
        with open(inst, 'r', encoding='utf-8', errors='replace') as f:
            for line in f:
                mm = re.match(r'^VERSION\s*=\s*(\d+)', line)
                if mm:
                    iv = int(mm.group(1))
                    break
    except Exception:
        pass
    if iv > VERSION:
        os.execv(sys.executable, [sys.executable, inst] + argv)
    try:
        os.makedirs(os.path.join(MON_DIR, 'state'), exist_ok=True)
        if iv < VERSION:
            shutil.copyfile(me, inst)
    except Exception:
        pass


def main(argv):
    args = list(argv)

    def opt(name, default=None):
        if name in args:
            i = args.index(name)
            if i + 1 < len(args):
                return args[i + 1]
        return default
    if '--help' in args or '-h' in args:
        print(open(os.path.abspath(__file__)).read().split('import json')[0])
        return 0
    if '--prefer-installed' in args:
        rest = [a for a in args if a != '--prefer-installed']
        prefer_installed(rest)
        args = rest
    ascii_mode = '--ascii' in args
    OPTS['ascii'] = ascii_mode
    demo = '--demo' in args
    state = opt('--state', os.path.join(MON_DIR, 'state'))
    sysobj = Sys(proc=opt('--proc', '/proc'), sysd=opt('--sys', '/sys'), runner=opt('--runner'))
    dm = None
    if demo:
        state = opt('--state') or tempfile.mkdtemp(prefix='onair-monitor-demo-')
        dm = Demo(state, t0=None)
    model = Model(state, sysobj, dm)
    dump = opt('--dump')
    if dump:
        sz = opt('--size', '120x40')
        try:
            W, H = [int(x) for x in sz.lower().split('x')]
        except Exception:
            W, H = 120, 40
        at = float(opt('--demo-at', '30'))
        now = time.time()
        if dm:
            dm.t0 = now - at
        model.collect(now - 0.5)
        m = model.collect(now)
        m['demo'] = bool(dm)
        lines = render(model, m, W, H, opt('--view', 'main'))
        with open(dump, 'w', encoding='utf-8') as f:
            if '--ansi' in args:
                f.write('\n'.join(to_ansi(lines, ascii_mode)) + '\n')
            else:
                f.write(to_plain(lines, ascii_mode))
        return 0
    if not sys.stdout.isatty():
        print('monitor.py: stdout is not a terminal (use --dump FILE for a snapshot)')
        return 2
    try:
        run_live(model, ascii_mode)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
