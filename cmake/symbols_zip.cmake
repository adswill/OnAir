# Run by the target debug_symbols_zip (CMakeLists.txt, ONAIR_DEBUG_SYMBOLS=ON) at build time:
#   cmake -DFILES=a|b -DOUT=<zip> -DSTAGE=<dir> -DVERSION=<v> -DSYSTEM=<Linux|Windows|Darwin> [-DOBJCOPY= -DREADELF= -DOBJDUMP= -DDSYMUTIL= -DDWARFDUMP=]
#         -P symbols_zip.cmake
# The zip holds, per program, the file as built (code + DWARF; it is its own symbol file, with the same build id as the stripped copy
# that ships) or on macOS a .dSYM bundle, and BUILD-IDS.txt (program, build id). Linux/Windows: the programs in the build folder are then
# stripped of their debug sections, so the packages made after this stay as small as before. Only CMake's own tar is used for the zip.
cmake_minimum_required(VERSION 3.16)

string(REPLACE "|" ";" FILES "${FILES}")
file(REMOVE_RECURSE "${STAGE}")
file(MAKE_DIRECTORY "${STAGE}")
file(REMOVE "${OUT}")

set(ids "OnAir ${VERSION} (${SYSTEM}): program, build id\n")
foreach(f IN LISTS FILES)
  if(NOT EXISTS "${f}")
    message(FATAL_ERROR "symbols_zip: ${f} does not exist")
  endif()
  get_filename_component(name "${f}" NAME)
  set(id "")
  if(SYSTEM STREQUAL "Darwin")
    if(NOT DSYMUTIL)
      message(FATAL_ERROR "symbols_zip: dsymutil not found")
    endif()
    execute_process(COMMAND "${DSYMUTIL}" "${f}" -o "${STAGE}/${name}.dSYM" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "symbols_zip: dsymutil ${name} failed")
    endif()
    if(DWARFDUMP)
      execute_process(COMMAND "${DWARFDUMP}" --uuid "${f}" OUTPUT_VARIABLE out ERROR_QUIET)
      string(REGEX MATCHALL "UUID: [0-9A-Fa-f-]+ \\([^)]+\\)" uu "${out}")
      string(REPLACE ";" ", " id "${uu}")
    endif()
  else()
    file(COPY "${f}" DESTINATION "${STAGE}")
    if(READELF AND NOT SYSTEM STREQUAL "Windows")
      execute_process(COMMAND "${READELF}" -n "${f}" OUTPUT_VARIABLE out ERROR_QUIET)
      string(REGEX MATCH "Build ID: ([0-9a-f]+)" _m "${out}")
      set(id "${CMAKE_MATCH_1}")
    elseif(OBJDUMP)
      execute_process(COMMAND "${OBJDUMP}" -p "${f}" OUTPUT_VARIABLE out ERROR_QUIET)
      string(REGEX MATCH "\\(format RSDS signature ([0-9a-f]+) age ([0-9]+)" _m "${out}")
      if(CMAKE_MATCH_1)
        set(id "RSDS ${CMAKE_MATCH_1} age ${CMAKE_MATCH_2}")
      endif()
    endif()
  endif()
  if(id STREQUAL "")
    set(id "(none found)")
  endif()
  string(APPEND ids "${name} ${id}\n")
endforeach()
file(WRITE "${STAGE}/BUILD-IDS.txt" "${ids}")

file(GLOB entries RELATIVE "${STAGE}" "${STAGE}/*")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}" --format=zip ${entries} WORKING_DIRECTORY "${STAGE}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "symbols_zip: writing ${OUT} failed")
endif()

if(NOT SYSTEM STREQUAL "Darwin" AND OBJCOPY)
  foreach(f IN LISTS FILES)
    execute_process(COMMAND "${OBJCOPY}" --strip-debug "${f}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(WARNING "symbols_zip: could not strip the debug sections of ${f}")
    endif()
  endforeach()
endif()
file(SIZE "${OUT}" sz)
message(STATUS "symbols_zip: ${OUT} (${sz} bytes)")
