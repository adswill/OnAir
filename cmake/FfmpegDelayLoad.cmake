# Windows (MinGW): the FFmpeg DLLs are delay-loaded, so that the app can load another FFmpeg build chosen by the user (Settings > Advanced >
# FFmpeg libraries, app/platform/ffmpeg_libs.h) before its first FFmpeg call; the delay-load stubs then bind to the modules already loaded.
# Without a choice they load the DLLs next to the program on the first call, as an ordinary import would.
# GNU ld has no /DELAYLOAD switch: dlltool makes a delay-import library per DLL from the export list of the normal import library (libX.dll.a).
#   dect2_ffmpeg_delayload(<interface target> "<lib dirs>" "<include dirs>" avutil swresample ...)
function(dect2_ffmpeg_delayload target libdirs incdirs)
  get_filename_component(_ccdir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  set(_pfx "")
  if(TOOLCHAIN_PREFIX)
    set(_pfx "${TOOLCHAIN_PREFIX}-")
  endif()
  find_program(DECT2_DLLTOOL NAMES ${_pfx}dlltool dlltool HINTS "${_ccdir}" REQUIRED)
  set(_nm "${CMAKE_NM}")
  if(NOT _nm)
    find_program(_nm NAMES ${_pfx}nm nm HINTS "${_ccdir}" REQUIRED)
  endif()
  if(NOT libdirs AND FFMPEG_LIBDIR)
    set(libdirs "${FFMPEG_LIBDIR}")   # pkg-config leaves out the system folder (MSYS2's /ucrt64/lib)
  endif()
  if(NOT libdirs)
    get_filename_component(libdirs "${_ccdir}/../lib" ABSOLUTE)
  endif()
  set(_out "${CMAKE_BINARY_DIR}/ffmpeg-delayload")
  file(MAKE_DIRECTORY "${_out}")
  add_library(${target} INTERFACE)
  target_include_directories(${target} INTERFACE ${incdirs})
  set(_dlls "")
  foreach(_name IN LISTS ARGN)
    find_file(_imp_${_name} NAMES lib${_name}.dll.a PATHS ${libdirs} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    if(NOT _imp_${_name})
      message(FATAL_ERROR "FFmpeg delay-load: lib${_name}.dll.a not found in ${libdirs} (FFmpeg must be the shared build)")
    endif()
    set(_imp "${_imp_${_name}}")
    execute_process(COMMAND "${DECT2_DLLTOOL}" --identify "${_imp}" OUTPUT_VARIABLE _dll OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _r)
    if(NOT _r EQUAL 0 OR NOT _dll)
      message(FATAL_ERROR "FFmpeg delay-load: dlltool --identify ${_imp} failed")
    endif()
    execute_process(COMMAND "${_nm}" -g "${_imp}" OUTPUT_VARIABLE _syms RESULT_VARIABLE _r)
    if(NOT _r EQUAL 0)
      message(FATAL_ERROR "FFmpeg delay-load: nm ${_imp} failed")
    endif()
    string(REGEX MATCHALL "__imp_[A-Za-z0-9_]+" _imps "${_syms}")
    list(REMOVE_DUPLICATES _imps)
    set(_def "LIBRARY ${_dll}\nEXPORTS\n")
    foreach(_s IN LISTS _imps)
      string(REGEX REPLACE "^__imp_" "" _s "${_s}")
      string(APPEND _def "  ${_s}\n")
    endforeach()
    file(WRITE "${_out}/${_name}.def" "${_def}")
    execute_process(COMMAND "${DECT2_DLLTOOL}" --input-def "${_out}/${_name}.def" --dllname "${_dll}" --output-delaylib "${_out}/lib${_name}.delay.a"
                    RESULT_VARIABLE _r ERROR_VARIABLE _err)
    if(NOT _r EQUAL 0)
      message(FATAL_ERROR "FFmpeg delay-load: dlltool failed for ${_dll}: ${_err}")
    endif()
    target_link_libraries(${target} INTERFACE "${_out}/lib${_name}.delay.a")
    list(APPEND _dlls "${_dll}")
  endforeach()
  target_link_libraries(${target} INTERFACE delayimp)   # mingw-w64's __delayLoadHelper2
  set(DECT2_FFMPEG_DLLS "${_dlls}" PARENT_SCOPE)
  message(STATUS "FFmpeg: delay-loaded ${_dlls}")
endfunction()
