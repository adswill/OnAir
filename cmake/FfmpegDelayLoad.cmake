# Windows (MinGW): FFmpeg is linked as DLLs and delay-loaded. The installed program finds them in lib\ffmpeg of its own folder
# (core/src/platform/ffmpeg_dll_hook_win.cpp loads them from there by full path, before the normal DLL search can pick another FFmpeg).
# GNU ld has no /DELAYLOAD switch: dlltool makes a delay-import library per DLL from the export list of the normal import library
# (libX.dll.a). Only functions can be delay-loaded: data exports are left out, so a use of one fails at link time instead of at run time.
#   dect2_ffmpeg_delayload(<interface target> "<lib dirs>" "<include dirs>" avutil swresample ...)
# Sets DECT2_FFMPEG_DLLS (the DLL names) and DECT2_FFMPEG_DLL_FILES (their paths) in the caller's scope, and copies the DLLs to
# <build>/lib/ffmpeg so the programs and tests of the build folder load them the same way as the installed program.
function(dect2_ffmpeg_delayload target libdirs incdirs)
  get_filename_component(_ccdir "${CMAKE_CXX_COMPILER}" DIRECTORY)
  set(_pfx "")
  if(TOOLCHAIN_PREFIX)
    set(_pfx "${TOOLCHAIN_PREFIX}-")
  endif()
  find_program(DECT2_DLLTOOL NAMES ${_pfx}dlltool x86_64-w64-mingw32-dlltool dlltool HINTS "${_ccdir}" REQUIRED)
  set(_nm "${CMAKE_NM}")
  if(NOT _nm)
    find_program(_nm NAMES ${_pfx}nm x86_64-w64-mingw32-nm nm HINTS "${_ccdir}" REQUIRED)
  endif()
  if(NOT libdirs)
    get_filename_component(libdirs "${_ccdir}/../lib" ABSOLUTE)   # pkg-config leaves out the system folder (MSYS2's /ucrt64/lib)
  endif()
  set(_out "${CMAKE_BINARY_DIR}/ffmpeg-delayload")
  file(MAKE_DIRECTORY "${_out}")
  add_library(${target} INTERFACE)
  target_include_directories(${target} INTERFACE ${incdirs})
  # the hook that loads the DLLs from lib\ffmpeg: compiled into every program that uses FFmpeg (a hook inside libdect2core.a would never be
  # pulled out of the archive, and mingw-w64's own empty __pfnDliNotifyHook2 in libmingwex would be used instead)
  target_sources(${target} INTERFACE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../core/src/platform/ffmpeg_dll_hook_win.cpp)
  set(_dlls "")
  set(_files "")
  foreach(_name IN LISTS ARGN)
    unset(_imp)
    find_file(_imp NAMES lib${_name}.dll.a PATHS ${libdirs} NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
    if(NOT _imp)
      message(FATAL_ERROR "FFmpeg: lib${_name}.dll.a not found in ${libdirs}: FFmpeg must be the shared build (tools/package/cross_deps_windows.sh)")
    endif()
    execute_process(COMMAND "${DECT2_DLLTOOL}" --identify "${_imp}" OUTPUT_VARIABLE _dll OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _r)
    if(NOT _r EQUAL 0 OR NOT _dll)
      message(FATAL_ERROR "FFmpeg: dlltool --identify ${_imp} failed")
    endif()
    execute_process(COMMAND "${_nm}" -g "${_imp}" OUTPUT_VARIABLE _syms RESULT_VARIABLE _r)
    if(NOT _r EQUAL 0)
      message(FATAL_ERROR "FFmpeg: nm ${_imp} failed")
    endif()
    string(REGEX MATCHALL "__imp_[A-Za-z0-9_]+" _imps "${_syms}")
    list(REMOVE_DUPLICATES _imps)
    set(_def "LIBRARY ${_dll}\nEXPORTS\n")
    foreach(_s IN LISTS _imps)
      string(REGEX REPLACE "^__imp_" "" _s "${_s}")
      # FFmpeg's data exports (FFmpeg 8.0: the exports outside .text of its DLLs; its import libraries give them code stubs like functions)
      if(_s MATCHES "_ffversion$|^avpriv_|^av_(aes|camellia|cast5|md5|ripemd|sha512|sha|tea|tree_node|twofish)_size$")
        continue()
      endif()
      string(APPEND _def "  ${_s}\n")
    endforeach()
    file(WRITE "${_out}/${_name}.def" "${_def}")
    execute_process(COMMAND "${DECT2_DLLTOOL}" --input-def "${_out}/${_name}.def" --dllname "${_dll}" --output-delaylib "${_out}/lib${_name}.delay.a"
                    RESULT_VARIABLE _r ERROR_VARIABLE _err)
    if(NOT _r EQUAL 0)
      message(FATAL_ERROR "FFmpeg: dlltool failed for ${_dll}: ${_err}")
    endif()
    target_link_libraries(${target} INTERFACE "${_out}/lib${_name}.delay.a")
    list(APPEND _dlls "${_dll}")
    # the DLL itself: bin/ next to lib/ (FFmpeg's install layout, also MSYS2's)
    get_filename_component(_ldir "${_imp}" DIRECTORY)
    get_filename_component(_bin "${_ldir}/../bin/${_dll}" ABSOLUTE)
    if(EXISTS "${_bin}")
      list(APPEND _files "${_bin}")
    else()
      message(WARNING "FFmpeg: ${_dll} not found next to ${_imp} (looked in ${_bin}): the programs of this build folder do not start without it")
    endif()
  endforeach()
  if(_files)
    file(COPY ${_files} DESTINATION "${CMAKE_BINARY_DIR}/lib/ffmpeg")
  endif()
  set(DECT2_FFMPEG_DLLS "${_dlls}" PARENT_SCOPE)
  set(DECT2_FFMPEG_DLL_FILES "${_files}" PARENT_SCOPE)
  message(STATUS "FFmpeg: delay-loaded from lib/ffmpeg: ${_dlls}")
endfunction()
