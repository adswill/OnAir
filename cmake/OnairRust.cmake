# The Rust code (the workspace rust/): one static library libonair_rs.a (crate rust/onair) holding every converted module. Rust is MANDATORY:
# the converted modules (ONAIR_RUST_ALL_MODULES below) exist only in Rust, there is no C++ copy to fall back to, so configuring without a
# usable cargo/rustc (>= 1.70) and the Rust target for this build stops with an error. Nothing is downloaded: the workspace has no external
# crates and is built with `cargo build --offline`; for a cross build (Windows with MinGW, Android, ...) install the target first
# (`rustup target add <triple>`; the error message names it).
#
# Opt-in by design (default OFF, so the C++ implementation is the one in use):
#   -DDECT2_RUST_RING=ON   the Rust IqRing instead of the C++ ring buffer (core/include/dect2/common/ring.h keeps both)
#   -DDECT2_RUST_USB=ON    the Android USB drivers in Rust instead of the desktop librtlsdr driver (needs a real device test)
#   -DDECT2_RUST_VITERBI=ON  (CMakeLists.txt) the Rust NEON Viterbi: about 4% slower than the C++ NEON one, so the C++ one is the default
#
# Results: ONAIR_RUST_ACTIVE (always TRUE), ONAIR_RUST_<MODULE> (TRUE for every converted module and for the opt-in ones that are ON),
# ONAIR_RUST_MODULES, the imported target onair_rs and the custom target onair_rs_cargo.
# C++ side: call onair_rust_use(<target>) on every target that compiles or links a converted module; it links onair_rs (and defines DECT2_RUST_USB when that opt-in is ON).
set(DECT2_RUST_RING "OFF" CACHE STRING "Opt-in: the Rust implementation of the RING module (IqRing): ON or OFF")
set(DECT2_RUST_USB "OFF" CACHE STRING "Opt-in: the Rust Android USB drivers: ON or OFF")
set(ONAIR_RUST_ALL_MODULES PROTO ADSB ACARS SAME PAGER AX25 DMR P25 NXDN DSTAR TETRA VDL2 HFDL MESH WISUN UAT TS DVBSI DAB DRM FILES NET ENGINE FEC USB RING KRIS KAWS)
set(ONAIR_RUST_OPT_IN USB RING)
set(ONAIR_RUST_ACTIVE FALSE)
set(ONAIR_RUST_MODULES "")
foreach(_m ${ONAIR_RUST_ALL_MODULES})
  set(ONAIR_RUST_${_m} TRUE)
  if(_m IN_LIST ONAIR_RUST_OPT_IN)
    if(DECT2_RUST_${_m} STREQUAL "ON")
      set(ONAIR_RUST_${_m} TRUE)
    else()
      set(ONAIR_RUST_${_m} FALSE)
    endif()
  endif()
endforeach()

function(onair_rust_use target)
  if(ONAIR_RUST_USB)
    target_compile_definitions(${target} PRIVATE DECT2_RUST_USB)   # the opt-in Android USB drivers (core/src/source/source_rtlsdr.cpp, rtl_fd_shim.h)
  endif()
  target_link_libraries(${target} PRIVATE onair_rs)
endfunction()

function(_onair_rust_unavailable why)
  message(FATAL_ERROR "Rust is required (the protocol, FEC, file, network and engine layers are written in Rust, rust/README.md): ${why}")
endfunction()

find_program(ONAIR_CARGO cargo)
find_program(ONAIR_RUSTC rustc)
if(NOT ONAIR_CARGO OR NOT ONAIR_RUSTC)
  _onair_rust_unavailable("cargo/rustc not found")
  return()
endif()

# Which Rust target does this build need, and is it installed?
execute_process(COMMAND ${ONAIR_RUSTC} -vV OUTPUT_VARIABLE _rv OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rvr)
execute_process(COMMAND ${ONAIR_RUSTC} --print sysroot OUTPUT_VARIABLE _sysroot OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT _rvr EQUAL 0 OR NOT _rv MATCHES "host: ([^\n]+)")
  _onair_rust_unavailable("rustc does not run")
  return()
endif()
set(_host_triple "${CMAKE_MATCH_1}")
if(_rv MATCHES "release: ([0-9]+\\.[0-9]+)" AND CMAKE_MATCH_1 VERSION_LESS 1.70)
  _onair_rust_unavailable("rustc ${CMAKE_MATCH_1} is older than 1.70")
  return()
endif()

set(_want "")
set(_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE)
  if(CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_SYSTEM_NAME STREQUAL "tvOS")
    _onair_rust_unavailable("no iOS support yet")
    return()
  endif()
  list(LENGTH CMAKE_OSX_ARCHITECTURES _narch)
  if(_narch GREATER 1)
    _onair_rust_unavailable("universal macOS builds are not supported yet")
    return()
  elseif(_narch EQUAL 1)
    set(_arch "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  if(_arch MATCHES "arm64|aarch64")
    set(_want "aarch64-apple-darwin")
  elseif(_arch MATCHES "x86_64|AMD64")
    set(_want "x86_64-apple-darwin")
  endif()
elseif(ANDROID)
  set(_abi "${ANDROID_ABI}")
  if(_abi STREQUAL "arm64-v8a")
    set(_want "aarch64-linux-android")
  elseif(_abi STREQUAL "armeabi-v7a")
    set(_want "armv7-linux-androideabi")
  elseif(_abi STREQUAL "x86_64")
    set(_want "x86_64-linux-android")
  elseif(_abi STREQUAL "x86")
    set(_want "i686-linux-android")
  endif()
elseif(WIN32)
  if(MSVC)
    set(_want "x86_64-pc-windows-msvc")
  elseif(_arch MATCHES "x86_64|AMD64")
    set(_want "x86_64-pc-windows-gnu")
  elseif(_arch MATCHES "i[3-6]86|X86")
    set(_want "i686-pc-windows-gnu")
  endif()
elseif(UNIX)
  if(CMAKE_CROSSCOMPILING)
    if(_arch MATCHES "aarch64|arm64")
      set(_want "aarch64-unknown-linux-gnu")
    elseif(_arch MATCHES "x86_64|AMD64")
      set(_want "x86_64-unknown-linux-gnu")
    elseif(_arch MATCHES "^arm")
      set(_want "armv7-unknown-linux-gnueabihf")
    endif()
  else()
    set(_want "${_host_triple}")
  endif()
endif()
if(_want STREQUAL "")
  _onair_rust_unavailable("no Rust target known for ${CMAKE_SYSTEM_NAME}/${_arch}")
  return()
endif()

set(_cross_flag "")
if(NOT _want STREQUAL _host_triple)
  if(NOT EXISTS "${_sysroot}/lib/rustlib/${_want}/lib")
    _onair_rust_unavailable("Rust target ${_want} is not installed (rustup target add ${_want}); nothing is downloaded")
    return()
  endif()
  set(_cross_flag --target ${_want})
  set(_out_sub "${_want}")
else()
  set(_out_sub "")
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
  set(_prof_flag "")
  set(_prof_dir "debug")
else()
  set(_prof_flag --release)
  set(_prof_dir "release")
endif()

set(_ws_dir "${ONAIR_ROOT}/rust")
set(_cargo_target "${CMAKE_BINARY_DIR}/rust")
if(_out_sub)
  set(_lib "${_cargo_target}/${_out_sub}/${_prof_dir}/libonair_rs.a")
else()
  set(_lib "${_cargo_target}/${_prof_dir}/libonair_rs.a")
endif()
file(GLOB_RECURSE _ws_src CONFIGURE_DEPENDS "${_ws_dir}/*/src/*.rs")
file(GLOB _ws_toml CONFIGURE_DEPENDS "${_ws_dir}/Cargo.toml" "${_ws_dir}/*/Cargo.toml")

# `--features bare`: the archive is no_std and carries the panic handler (see rust/onair/src/lib.rs)
add_custom_command(
  OUTPUT "${_lib}"
  COMMAND ${CMAKE_COMMAND} -E env --unset=MAKEFLAGS --unset=MFLAGS --unset=CARGO_MAKEFLAGS CARGO_TARGET_DIR=${_cargo_target} ${ONAIR_CARGO} build ${_prof_flag} --offline ${_cross_flag}
          --manifest-path ${_ws_dir}/Cargo.toml -p onair --features bare
  DEPENDS ${_ws_src} ${_ws_toml}
  COMMENT "cargo build onair_rs (${_want}, ${_prof_dir})"
  VERBATIM)
add_custom_target(onair_rs_cargo DEPENDS "${_lib}")
add_library(onair_rs STATIC IMPORTED GLOBAL)
set_target_properties(onair_rs PROPERTIES IMPORTED_LOCATION "${_lib}")
add_dependencies(onair_rs onair_rs_cargo)

set(ONAIR_RUST_ACTIVE TRUE)
foreach(_m ${ONAIR_RUST_ALL_MODULES})
  if(ONAIR_RUST_${_m})
    list(APPEND ONAIR_RUST_MODULES ${_m})
  endif()
endforeach()
list(JOIN ONAIR_RUST_MODULES " " _mods)
message(STATUS "Rust code: ${_mods} (${_want}, ${_prof_dir}; ${ONAIR_CARGO})")
